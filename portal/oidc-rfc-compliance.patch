+# RFC 6749 section 3.1: request parameters MUST NOT be included more than
+# once. Plack merges duplicated parameters (the last value wins), so the
+# underlying Hash::MultiValue has to be checked.
+# Some parameters may be repeated: "resource" (RFC 8707 section 2) and
+# "audience" (RFC 8693 section 2.1).
+# @param allowed names of parameters that may be repeated
+# @return true if a parameter is given more than once
+sub hasDuplicatedParameters {
+    my ( $self, $req, @allowed ) = @_;
+    my %allowed = map { $_ => 1 } @allowed;
+
+    # Query string and body are checked separately: the portal posts OIDC
+    # parameters as hidden fields on the same URL, so the same parameter is
+    # legitimately present in both
+    foreach my $params ( $req->query_parameters, $req->body_parameters ) {
+        next unless ( blessed($params) and $params->can('get_all') );
+        foreach my $name ( $params->keys ) {
+            next if $allowed{$name};
+
+            # get_all() returns the last value in scalar context
+            my @values = $params->get_all($name);
+            return 1 if @values > 1;
+        }
+    }
+    return 0;
+}
