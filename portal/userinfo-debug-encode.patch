OIDC userinfo: JSON-encode the response for its debug line only at logLevel debug
See https://github.com/guimard/llng-docker/issues/110
Upstream: https://gitlab.ow2.org/lemonldap-ng/lemonldap-ng/-/issues/3932
Upstream: https://gitlab.ow2.org/lemonldap-ng/lemonldap-ng/-/commit/2bfa315ff5eda58f240914487ac789d1dbb0291b

--- a/usr/share/perl5/Lemonldap/NG/Portal/Issuer/OpenIDConnect.pm
+++ b/usr/share/perl5/Lemonldap/NG/Portal/Issuer/OpenIDConnect.pm
@@ -2250,9 +2250,14 @@
       $self->rpOptions->{$rp}->{oidcRPMetaDataOptionsUserInfoSignAlg};
 
     unless ($userinfo_sign_alg) {
-        my $debug_response = to_json($userinfo_response);
-        utf8::downgrade($debug_response);
-        $self->logger->debug( "Return UserInfo as JSON: " . $debug_response );
+        # encoded for the debug line only when it is written: the logger
