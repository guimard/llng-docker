+# Build a Message-ID header value using mailFrom domain (some providers
+# penalize messages without Message-ID)
+sub messageId {
+    my ($conf) = @_;
+    my $domain = ( $conf->{mailFrom} // '' ) =~ /\@([\w.-]+)/ ? $1 : hostname;
+    my $id =
+      Lemonldap::NG::Common::Crypto::srandom()->randregex('[0-9a-f]{32}');
+    return "<$id\@$domain>";
+}
