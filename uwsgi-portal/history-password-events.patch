Description: Do not count password reset/change as failed logins
 BruteForceProtection reads the failedLogin history, but registerLogin
 classified any positive PE code as a failed login. During a mandatory
 password change at login (pwdReset), the flow ends with
 PE_PP_CHANGE_AFTER_RESET then PE_PASSWORD_OK, so every password change
 added two bogus failedLogin entries and locked the account too soon.
 .
 Only negative results (error_type) are real login failures now.
Origin: upstream, https://gitlab.ow2.org/lemonldap-ng/lemonldap-ng/-/merge_requests/993
 (commit 923eebd589, #3634, v2.23.3)

--- a/usr/share/perl5/Lemonldap/NG/Portal/Main/Run.pm
+++ b/usr/share/perl5/Lemonldap/NG/Portal/Main/Run.pm
@@ -1370,7 +1370,16 @@
     }

     my $history = $req->sessionInfo->{_loginHistory} ||= {};
-    my $type    = ( $req->authResult > 0 ? 'failed' : 'success' ) . 'Login';
+
+    # Only negative results are real login failures. Positive/warning results
+    # such as PE_PP_CHANGE_AFTER_RESET or PE_PASSWORD_OK must not be stored as
+    # failed logins, else they wrongly feed BruteForceProtection (#3634).
+    my $type = (
+        ( $req->authResult > 0
+              && $req->error_type( $req->authResult ) eq 'negative' )
+        ? 'failed'
+        : 'success'
+    ) . 'Login';
     $history->{$type} ||= [];
     $self->logger->debug("Current login saved into $type");

