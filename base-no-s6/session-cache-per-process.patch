+# One cache object per process and per (module, options), shared by every
+# tied session and by the lock: populate() builds a new Store and a new Lock
+# for each tie, and each used to compile "use $module" in a string eval and
+# construct its own cache object (a Cache::FileCache is only its options:
+# every get or set reads or writes its files). The options come from the
+# configuration, so a new configuration gets a new object.
+our %CACHES;
+
+sub cache_for {
+    my ( $module, $options ) = @_;
+    my $key = $module . "\0"
+      . ( $options ? JSON->new->canonical->allow_blessed->encode($options) : '' );
+    return $CACHES{$key} //= do {
+        eval "use $module;";
+        $module->new($options);
+    };
+}
+
 sub cache {
     my $self = shift;
 
     return $self->{cache} if $self->{cache};
 
-    my $module = $self->{args}->{localStorage};
-    eval "use $module;";
-    $self->{cache} = $module->new( $self->{args}->{localStorageOptions} );
+    $self->{cache} = cache_for( $self->{args}->{localStorage},
+        $self->{args}->{localStorageOptions} );
 
     return $self->{cache};
 }
