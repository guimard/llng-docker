+# Run $code and die with $msg if it lasts more than $timeout seconds.
+#
+# POSIX::sigaction() is required: a %SIG handler is delayed by Perl until the
+# current C call returns, and libpq restarts poll() on EINTR, so a query sent
+# to an unreachable server would stay blocked until the kernel gives up (about
+# 15 minutes). See "Signal Handling and Canceling Operations" in DBI(3).
+#
+# Once expired, the alarm is re-armed every second: $code may catch the first
+# die (DBI calls are often wrapped into eval) and block again.
+#
+# Note that an interrupted DBI handle is in an unknown state and must be
+# dropped by the caller.
+sub timeout_call {
+    my ( $timeout, $code, $msg ) = @_;
+    $msg ||= "timeout\n";
+    my $expired;
+    my $action = POSIX::SigAction->new(
+        sub {
+            $expired = 1;
+            alarm(1);
+            die $msg;
+        },
+        POSIX::SigSet->new(SIGALRM)
+    );
+    my $oldaction = POSIX::SigAction->new();
+    sigaction( SIGALRM, $action, $oldaction );
+    my ( @res, $err );
+    eval {
+        eval {
+            alarm($timeout);
+            @res = $code->();
+        };
+        $err = $@;
+        alarm(0);
+    };
+    alarm(0);
+    sigaction( SIGALRM, $oldaction );
+    $err ||= $msg if $expired;
+    die $err      if $err;
+    return wantarray ? @res : $res[0];
+}
+
 1;
