Origin: https://github.com/rezk2ll/lemonldap-ng/tree/feat/cas-srv-options (not proposed upstream yet)
Credits: Khaled Ferjani <https://github.com/rezk2ll>

--- a/usr/share/perl5/Lemonldap/NG/Manager/Build/Attributes.pm
+++ b/usr/share/perl5/Lemonldap/NG/Manager/Build/Attributes.pm
@@ -4366,6 +4366,12 @@ m{^(?:ldapi://[^/]*/?|\w[\w\-\.]*(?::\d{1,5})?|ldap(?:s|\+tls)?://\w[\w\-\.]*(?:
