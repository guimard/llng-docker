+sub _emptyLog {
+    my ($conf) = @_;
+    return ( !defined $conf->{cfgLog} or $conf->{cfgLog} !~ /\S/ );
+}
+
+# Fill an empty cfgLog with a summary of changes since the stored configuration
+sub _autoCfgLog {
+    my ( $self, $old, $new ) = @_;
+    return unless ref $old eq 'HASH' and _emptyLog($new);
+    require Lemonldap::NG::Manager::Conf::Summary;
+    my $log =
+      eval { Lemonldap::NG::Manager::Conf::Summary::summary( $old, $new ) };
+    if ($@) {
+        $self->logger->warn("Unable to build configuration summary: $@");
+        return;
+    }
+    $new->{cfgLog} = $log if $log;
+}
