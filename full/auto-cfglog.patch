diff -Nru a/usr/share/perl5/Lemonldap/NG/Manager/Conf/Summary.pm b/usr/share/perl5/Lemonldap/NG/Manager/Conf/Summary.pm
--- a/usr/share/perl5/Lemonldap/NG/Manager/Conf/Summary.pm
+++ b/usr/share/perl5/Lemonldap/NG/Manager/Conf/Summary.pm
